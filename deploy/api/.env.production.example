# africadawah store API, production — the env file for ta3lom_store_api's deploy/compose.yaml (NOT secrets: they live in
# SECRETS_DIR, see that repo's deploy/secrets.md). Copy it next to the API's compose.yaml as `.env.production`, then:
#   docker compose --env-file .env.production -p africadawah-store -f compose.yaml -f compose.africadawah.yaml …
COMPOSE_PROJECT_NAME=africadawah-store
STORE_ENVIRONMENT=Production
STORE_VERSION=1.0.0                         # API image tag X.Y.Z
API_DOMAIN=store-api.africadawah.org
WEB_DOMAIN=store.africadawah.org
EDGE_ALIAS=africadawah-store-api                        # deploy/edge/store.caddy proxies store-api.africadawah.org → africadawah-store-api:8080
EDGE_SUBNET=172.18.0.0/16                   # = docker network inspect edge (IPv4 subnet) on this VPS; setup-production.sh checks it
SECRETS_DIR=./secrets/production
SITE_REBUILD_REPOSITORY=lotfi029/african_store_web   # NOT the API's default (ta3lom's web): publishing rebuilds this site
SMS_SENDER_ID=                              # Unifonic sender id approved for the association
SMTP_USER=store@africadawah.org             # the mailbox the API signs in to (password: secret Store__Email__Password)
SMTP_HOST=smtp.hostinger.com                # that mailbox's SMTP server (port 465, SSL)
OTLP_ENDPOINT=
PAYMENTS_PROVIDER=none                      # showcase until the Moyasar account exists; then: moyasar
CUSTOMER_SIGNIN=false                       # showcase; then: true
