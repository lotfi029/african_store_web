# Store sites on the shared edge Caddy (inherited from ta3lom_store_web F8). The VPS edge config lives in the owner's edge
# deploy repo, so this block lives here and the owner copies it to that repo's `edge/conf/africadawad-store.caddy`, imported by `Caddyfile`,
# `Caddyfile.cutover` and `Caddyfile.staging` (deploy/edge/README.md). Validated by scripts/validate-caddy.sh.
# Upstreams are Docker aliases on the external `edge` network (no published ports):
#   africadawad-store-web / africadawad-store-web-staging  — this repo's container (deploy/docker-compose.store-web.yml), :8080
#   africadawad-store-api / africadawad-store-api-staging  — the store API (ta3lom_store_api deploy/compose.yaml), :8080
# The containers send their own CSP and security headers; the edge adds only HSTS (production names) and noindex
# (staging names). The edge sets X-Forwarded-For/Proto; the API trusts them only from the edge subnet
# (Store__ForwardedHeaders__KnownNetworks__0 = EDGE_SUBNET).

# "?" = only when the container did not send it: the API and the staging web send these headers themselves, and a
# duplicated X-Robots-Tag reads as "noindex, nofollow, noindex, nofollow" (smoke-deploy refuses it).
(africadawad_store_hsts) {
	header ?Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

(africadawad_store_noindex) {
	header ?X-Robots-Tag "noindex, nofollow"
}

# The API: 21 MB bodies (20 MB media uploads + multipart overhead); the payment webhook is never cached or buffered so
# the API reads the raw body itself (signature check, 256 KB limit enforced by the API).
(africadawad_store_api) {
	request_body {
		max_size 21MB
	}
	@webhook path /v1/payments/webhooks/*
	handle @webhook {
		header Cache-Control "no-store"
		reverse_proxy {args[0]}:8080 {
			flush_interval -1
			request_buffers 0
			response_buffers 0
		}
	}
	handle {
		reverse_proxy {args[0]}:8080
	}
}

store.africadawad.org {
	import africadawad_store_hsts
	encode zstd gzip
	reverse_proxy africadawad-store-web:8080
}

store-api.africadawad.org {
	import africadawad_store_hsts
	import africadawad_store_api africadawad-store-api
}

store-staging.africadawad.org {
	import africadawad_store_noindex
	encode zstd gzip
	reverse_proxy africadawad-store-web-staging:8080
}

store-api-staging.africadawad.org {
	import africadawad_store_noindex
	import africadawad_store_api africadawad-store-api-staging
}
